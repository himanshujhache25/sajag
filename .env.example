# Everything here is optional. With none of it set, the whole product works:
# the check runs on the phone and the server routes answer 501 so the app
# falls back quietly.

# Language model used only to explain a result and to tidy a complaint draft.
# It can never set or lower a verdict.
LLM_PROVIDER=          # none | gemini | openai-compatible
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=          # only for openai-compatible

# Bhashini, for speech in Indian languages. Needs registration at bhashini.gov.in.
BHASHINI_API_KEY=

# Salt for the k-anonymous community report lookup. Any long random string.
RADAR_PEPPER=
