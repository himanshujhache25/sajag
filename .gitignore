# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
j1.txt
.*.txt

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example carries no secrets and documents the optional settings, so it
# is the one that is meant to be read by anyone cloning the repository.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The on-device OCR engine: worker, wasm core and language data, about 33 MB.
# Copied out of node_modules and downloaded by scripts/ocr-assets.mjs on
# install, so it is generated rather than committed.
/public/tesseract/

# Scratch files written while debugging: command output redirected out of the
# way, and one-off probe scripts. None of it belongs in a commit.
.t.txt
.v.txt
.e.txt
.i.txt
.p.txt
.ev.txt
.probe.ts
